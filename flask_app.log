2025-02-16 21:12:36,684 - my_app - DEBUG - gen_cases function called with parameters: language=English, age=20, subject=Pilot, difficulty=hard, question_type=hiring, subtype=technical_skills, sex=unspecified, conversation_data={'data': {'cases': [{'case': "You are approaching a runway for landing, and the air traffic controller (ATC) suddenly issues a 'go-around' instruction due to unexpected traffic on the runway. What's your immediate course of action?", 'optimal': '2', 'options': [{'number': 1, 'option': 'Immediately initiate a steep climb and turn back to the approach, disregarding standard procedures to expedite the maneuver.', 'technical_skills': 2, 'behavioral_skills': 1, 'situational_judgment': 1, 'option_id': 'ff732614-0777-4b6a-b5a8-35fecb753e41'}, {'number': 2, 'option': "Acknowledge the 'go-around' instruction, increase thrust to climb power, establish a positive rate of climb, and follow the published missed approach procedure.", 'technical_skills': 5, 'behavioral_skills': 4, 'situational_judgment': 5, 'option_id': 'f4fe13d2-1a27-49ef-83ee-8f4624bae85b'}, {'number': 3, 'option': "Question the ATC's instruction, arguing that the traffic situation is unclear and you believe you can still safely land.", 'technical_skills': 1, 'behavioral_skills': 1, 'situational_judgment': 1, 'option_id': 'e8bc8bd5-6e98-4eb2-9dba-0ceee9348671'}, {'number': 4, 'option': "Execute the 'go-around' but delay communication with ATC until the aircraft is stable and climbing.", 'technical_skills': 3, 'behavioral_skills': 2, 'situational_judgment': 3, 'option_id': '4271e43e-45f0-4930-b786-47e59299feef'}, {'number': 5, 'option': 'Rapidly descend below the glideslope altitude to increase separation from the other traffic, prior to initiating the go-around.', 'technical_skills': 1, 'behavioral_skills': 1, 'situational_judgment': 1, 'option_id': '75e44a29-9507-4e98-b418-a3b8de4af406'}, {'number': 6, 'option': "Initiate the 'go-around' while simultaneously adjusting the autopilot settings to match the missed approach parameters.", 'technical_skills': 4, 'behavioral_skills': 3, 'situational_judgment': 4, 'option_id': 'fb43a919-a74b-42c9-8b8c-5f69f6858962'}, {'number': 7, 'option': "Consult with the co-pilot extensively about the optimal course of action, potentially delaying the execution of the 'go-around'.", 'technical_skills': 2, 'behavioral_skills': 3, 'situational_judgment': 2, 'option_id': '9806b22f-5372-43f4-a7c9-ba56f779f056'}, {'number': 8, 'option': "Acknowledge the 'go-around', initiate climb power, but prioritize maintaining visual contact with the traffic on the runway, potentially deviating from the missed approach path.", 'technical_skills': 3, 'behavioral_skills': 2, 'situational_judgment': 2, 'option_id': 'c02e45c1-f709-4a37-bd74-55b120dfa8c5'}]}, {'case': 'During a long-haul flight at high altitude, you experience an uncommanded autopilot disconnection accompanied by a warning indicating a potential sensor failure. How do you troubleshoot and respond to this situation?', 'optimal': '3', 'options': [{'number': 1, 'option': 'Assume the autopilot malfunction is temporary and simply re-engage it without further investigation.', 'technical_skills': 1, 'behavioral_skills': 1, 'situational_judgment': 1, 'option_id': '6b04d475-1aca-4478-bf87-4e18a9a246d7'}, {'number': 2, 'option': 'Immediately descend to a lower altitude, regardless of fuel consumption or weather conditions, to reduce stress on the aircraft systems.', 'technical_skills': 2, 'behavioral_skills': 2, 'situational_judgment': 2, 'option_id': '4d845f85-b006-4050-9b80-455a198ed777'}, {'number': 3, 'option': "Cross-check the aircraft's attitude and heading with independent instruments, consult the Quick Reference Handbook (QRH) for the autopilot failure, and attempt to isolate the faulty sensor if possible. Transition to manual flight if necessary.", 'technical_skills': 5, 'behavioral_skills': 4, 'situational_judgment': 5, 'option_id': '931d4e67-eed2-4be1-a882-efa9380c8a22'}, {'number': 4, 'option': 'Declare an emergency immediately, even if the aircraft is still controllable, to ensure priority handling by ATC.', 'technical_skills': 2, 'behavioral_skills': 2, 'situational_judgment': 2, 'option_id': 'a9af2dce-3938-47f7-9ca9-0a1c97155fdb'}, {'number': 5, 'option': 'Attempt to diagnose the problem by cycling the autopilot system power on and off repeatedly, hoping to reset the system.', 'technical_skills': 1, 'behavioral_skills': 1, 'situational_judgment': 1, 'option_id': '0c962cff-55d3-4186-8799-64551a2d5f71'}, {'number': 6, 'option': "Continue flying with the autopilot disengaged but avoid making any changes to the aircraft's configuration or flight path.", 'technical_skills': 3, 'behavioral_skills': 3, 'situational_judgment': 3, 'option_id': 'f90b167d-16c6-4b3a-971b-4c801b58d05f'}, {'number': 7, 'option': 'Rely solely on the co-pilot to troubleshoot the problem while you maintain control of the aircraft.', 'technical_skills': 3, 'behavioral_skills': 2, 'situational_judgment': 3, 'option_id': '4f47a95f-2761-4595-bb64-9335e7365b68'}, {'number': 8, 'option': "Consult the aircraft's maintenance logs to see if there have been previous reports of autopilot malfunctions.", 'technical_skills': 3, 'behavioral_skills': 2, 'situational_judgment': 3, 'option_id': '714e76dd-3b6c-445c-91fe-eb12209f7655'}]}, {'case': 'You are preparing for takeoff in a high-performance aircraft and notice that the indicated airspeed (IAS) is significantly lower than expected during the takeoff roll, despite the engines running at full power. What are your immediate actions?', 'optimal': '2', 'options': [{'number': 1, 'option': "Continue the takeoff run, assuming the airspeed indicator is faulty and relying on your 'seat-of-the-pants' feel for the aircraft's speed.", 'technical_skills': 1, 'behavioral_skills': 1, 'situational_judgment': 1, 'option_id': 'e83630b5-8926-43df-839c-d91826deddea'}, {'number': 2, 'option': 'Immediately abort the takeoff, apply maximum braking, and initiate emergency procedures to bring the aircraft to a safe stop on the runway.', 'technical_skills': 5, 'behavioral_skills': 4, 'situational_judgment': 5, 'option_id': 'f096fd72-3412-476a-9e3d-88ba7e6129ad'}, {'number': 3, 'option': 'Attempt to recalibrate the airspeed indicator in flight by adjusting the pitot-static system.', 'technical_skills': 1, 'behavioral_skills': 1, 'situational_judgment': 1, 'option_id': 'd1a150aa-a7de-452c-b2f3-f1cbef37f994'}, {'number': 4, 'option': 'Reduce engine power to idle and wait for the airspeed to catch up before resuming the takeoff run.', 'technical_skills': 2, 'behavioral_skills': 2, 'situational_judgment': 2, 'option_id': 'edc23a1f-29bf-432c-a261-c075c1bb6d14'}, {'number': 5, 'option': 'Ignore the airspeed discrepancy and focus on maintaining a steady heading during the takeoff roll.', 'technical_skills': 1, 'behavioral_skills': 1, 'situational_judgment': 1, 'option_id': '4fac4f0e-e622-48fd-be66-9906954e3e9a'}, {'number': 6, 'option': 'Consult the co-pilot about the airspeed reading and decide whether to continue the takeoff based on their assessment.', 'technical_skills': 3, 'behavioral_skills': 3, 'situational_judgment': 3, 'option_id': 'ec48772e-622f-479f-862e-f16cf445cb6a'}, {'number': 7, 'option': 'Attempt to override the airspeed indicator with data from the GPS ground speed, without verifying its accuracy.', 'technical_skills': 2, 'behavioral_skills': 1, 'situational_judgment': 1, 'option_id': 'abe99e35-e653-4187-a1bb-8f75bded9663'}, {'number': 8, 'option': 'Continue the takeoff run, but reduce the rotation speed to compensate for the lower indicated airspeed.', 'technical_skills': 2, 'behavioral_skills': 2, 'situational_judgment': 2, 'option_id': 'be41f754-5e4d-427e-a74a-befbe8d4fbe4'}]}], 'user_answers': [1, 1, 1]}}
